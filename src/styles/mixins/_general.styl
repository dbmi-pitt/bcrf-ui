px2em($prop, $sz, $bf = null)
  if $bf == null 
    $bf = $base-font
  
  $result = ceil(($sz/$bf), 2) * 1rem
  if $prop
    {$prop} $result
  else 
    return $result
    
lh-ratio($font-sz, $lh)
  line-height ($lh/$font-sz) 
  
focus($size = null)
  theme(outline-color, $col-main-blue $col-main-pink)
  if $size == null 
    $size = 1.4px
  outline-style dotted
  outline-width $size

pos-abs()
  position absolute 

pos-rel()
  position relative

blk()
  display block

hide()
  display none

container()
  max-width 1000px
  margin auto
  +md-max()
    padding 0 $mgn

bx-shadow()
  box-shadow 0 0 10px rgba(0, 0, 0, 0.1)

formInvalid()
  border solid 1px red !important
  box-shadow 0 0 0 .25rem #fd0d0d40 !important

font-hurme($mod = 'Hurme Regular', $spacing = normal)
  font-family $mod, Georgia, monospace
  letter-spacing $spacing

font-hurmeSemiBold()
  font-hurme('Hurme SemiBold', 2px)

headings()
  h1, h2, h3, h4, h5, h6
    font-hurmeSemiBold()