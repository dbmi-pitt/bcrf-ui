.cm__btn
.pm__btn
  overflow clip
  position relative
  transition .2s transform ease-in-out
  will-change transform
  z-index 0
  display inline-block
  padding .5em 1.5em
  text-transform uppercase
  border 0
  p3()

.cm__btn
.pm__btn
  background-color $col-primary-accent !important
  border-color $col-primary-accent !important
  color white !important

  &:hover
    border-color $col-bcrf-blue !important

  &::after
    background-color $col-bcrf-blue

.cm__btn--secondary
.pm__btn--secondary
  background-color $col-bcrf-blue !important
  border-color darken($col-bcrf-blue, 0.3) !important
  color white !important

  &:hover
    border-color $col-primary-accent !important

  &::after
    background-color $col-primary-accent