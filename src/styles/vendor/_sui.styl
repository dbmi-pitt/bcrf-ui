.sui
  &-layout
    &-body, &-header
      background-color #eff5f7
    &-body
      &:after
        content none

  &-facet-view-more
    color $col-primary-pink

  &-select__control--is-focused
    border-color $col-primary-pink

  &-search-box__text-input
    &:focus
      border-color $col-primary-pink
      outline none