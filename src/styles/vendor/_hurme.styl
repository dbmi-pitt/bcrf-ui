@font-face
  font-family 'Hurme SemiBold'
  src url('../fonts/Hurme-Geometric-Sans-4/HurmeGeometricSans4 SemiBold.otf')

@font-face
  font-family 'Hurme Thin'
  src url('../fonts/Hurme-Geometric-Sans-4/HurmeGeometricSans4 Thin.otf')

@font-face
  font-family 'Hurme Regular'
  src url('../fonts/Hurme-Geometric-Sans-4/HurmeGeometricSans4.otf')

.hurmeFont
  &Heading
    font-hurmeSemiBold()

  &SemiBold
    font-hurme('Hurme SemiBold')

  &Regular
    font-hurme()

  &Thin
    font-hurme('Hurme Thin')