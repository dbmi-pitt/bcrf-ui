@font-face
  font-family 'Inter Regular'
  src url('../fonts/Inter/Inter_18pt-Regular.ttf')

@font-face
  font-family 'Inter Thin'
  src url('../fonts/Inter/Inter_18pt-Thin.ttf')

@font-face
  font-family 'Inter Medium'
  src url('../fonts/Inter/Inter_18pt-Medium.ttf')

@font-face
  font-family 'Inter ExtraBold'
  src url('../fonts/Inter/Inter_18pt-ExtraBold.ttf')

@font-face
  font-family 'Merriweather Regular'
  src url('../fonts/Merriweather/Merriweather_24pt-Regular.ttf')

@font-face
  font-family 'Merriweather Bold'
  src url('../fonts/Merriweather/Merriweather_24pt-Bold.ttf')

.font
  &--Inter
    &--Thin
      font('Inter Thin')

    &--Regular
      font('Inter Regular')

    &--Medium
      font('Inter Medium')

    &--ExtraBold
      font('Inter ExtraBold')

  &--Merriweather
    &--Regular
      font('Merriweather Regular')

    &--Bold
      font('Merriweather Bold')