.c-box
  pos-rel()
  text-align left

  &__head
    pos-rel()

    &.has-edgeImg
      &.c-box__head
        &:before
          top 0
          left 0
          pos-abs()

        &--l
          &:before
            top -70px
            left -140px
            content url('data:image/png;base64,')

        &--r
          &:before
            top -50px
            left -90px
            content url('data:image/png;base64,')

  &__wrap
    margin 0 10%
    +md-max()
      margin 0 $mgn

  &--contentPage
    headings()

    p, &__body
      p3()
      font()

    a
      color $col-primary-accent


  &--flex
    display flex
    flex-direction row
    justify-content center
    +md-max()
      display block

    .col
      margin-left $mgn * 2
      margin-bottom $mgn * 2
      +md-max()
        margin-left 0
        margin-bottom $mgn * 2 * 2

      &:first-child
        margin-left 8%
        +xxlg-max()
          margin-left 0

    .c-box__body
      width 70%
      +xxlg-max()
        width 90%
      +md-max()
        width 100%

  &--surrounded
    padding 3.5rem 25%
    +xlg-max()
      padding 3rem 12.5%
    +md-max()
      padding 3rem $mgn
    p
      font()

    &--slim
      padding 2rem 10rem
      +xxlg()
        padding 2rem 20rem
      +md-max()
        padding $mgn
        .row
          display block

          h1
            margin-bottom $mgn
            text-align left

      h1, h2, h3
        letter-spacing normal !important
        margin-bottom 0
        text-align center

      p
        font()

  &--centered
    pos-abs()
    top 50%
    left 50%
    transform translate(-50%, -50%)

  headings()

  h2
    margin 1.5rem 0 !important

  p
    font()
    margin $mgn 0

  img
    +md-max()
      width 100%

  .mgn-v-10
    margin-top 8rem
    margin-bottom 8rem

  .c-btn
    +md-max()
      width 100%
