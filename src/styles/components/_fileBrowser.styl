.c-fileBrowser
  &__header
    background-color $col-primary-light
    color black
    display flex
    justify-content space-between 
    padding 8px 12px 8px 36px
    font-weight bold
    border-bottom 1px solid #f0f0f0
    border-top-left-radius 10px
    border-top-right-radius 10px

  &__row
    display flex 
    justify-content space-between 
    width 100%
    align-items center
    padding .5rem 0
  &__title
    flex 1
    text-overflow ellipsis
    overflow hidden 
    white-space nowrap
  &__meta
    display flex
    gap 40px
    width 250px 
    text-align right 
    padding-right 12px
    span 
      display inline-block
  &__previewNotice 
    display flex 
    align-items center 
    justify-content center
    height 100%
    &.alert
      border-style dashed
      &-secondary
        background-color $col-lgt-grey
        color grey